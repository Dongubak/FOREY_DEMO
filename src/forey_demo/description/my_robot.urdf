<?xml version="1.0" ?>
<robot name="robot">
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
  <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>

  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
    
      <wheel_separation>0.185</wheel_separation>
      <wheel_radius>0.03725</wheel_radius>
    
      <odom_publish_frequency>20</odom_publish_frequency> <max_linear_acceleration>1.0</max_linear_acceleration> <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
  </gazebo>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.03725"/>
  </joint>

  <link name="base_link"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin rpy="0 0 0" xyz="-0.1015 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0.1015 0.0 0.0285"/>
      <geometry><box size="0.203 0.106 0.057"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.1015 0.0 0.0285"/>
      <geometry><box size="0.203 0.106 0.057"/></geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.1015 0.0 0.0285"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="left_front_wheel"/>
    <origin rpy="-1.570796326795 0 0" xyz="0.1785 0.0865 -0.00602"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_front_wheel">
    <visual><geometry><cylinder length="0.02" radius="0.03725"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder length="0.02" radius="0.03725"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="left_rear_wheel"/>
    <origin rpy="-1.570796326795 0 0" xyz="0.0245 0.0865 -0.00602"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_rear_wheel">
    <visual><geometry><cylinder length="0.02" radius="0.03725"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder length="0.02" radius="0.03725"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="right_front_wheel"/>
    <origin rpy="-1.570796326795 0 0" xyz="0.1785 -0.0865 -0.00602"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_front_wheel">
    <visual><geometry><cylinder length="0.02" radius="0.03725"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder length="0.02" radius="0.03725"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="right_rear_wheel"/>
    <origin rpy="-1.570796326795 0 0" xyz="0.0245 -0.0865 -0.00602"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_rear_wheel">
    <visual><geometry><cylinder length="0.02" radius="0.03725"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder length="0.02" radius="0.03725"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>

  <joint name="LiDAR_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin rpy="0 0 0" xyz="0.141188 0 0.1468"/>
  </joint>
  <link name="laser_frame">
    <visual><geometry><cylinder length="0.019" radius="0.0385"/></geometry><material name="green"/></visual>
    <collision><geometry><cylinder length="0.019" radius="0.0385"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/></inertial>
  </link>

  <gazebo reference="laser_frame">
  <sensor name="gpu_lidar" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <visualize>true</visualize>
    <update_rate>3</update_rate> <lidar>
      <scan>
        <horizontal>
          <samples>120</samples> <resolution>1</resolution>
          <min_angle>-3.14</min_angle>
          <max_angle>3.14</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min> <max>12.0</max>
      </range>
    </lidar>
    <topic>scan</topic>
    <gz_frame_id>laser_frame</gz_frame_id>
  </sensor>
</gazebo>

<gazebo reference="left_front_wheel">
    <mu1>3.0</mu1> <mu2>3.0</mu2>
</gazebo>

<gazebo reference="left_rear_wheel">
    <mu1>3.0</mu1> <mu2>3.0</mu2>
</gazebo>

<gazebo reference="right_front_wheel">
    <mu1>3.0</mu1> <mu2>3.0</mu2>
</gazebo>

<gazebo reference="right_rear_wheel">
    <mu1>3.0</mu1> <mu2>3.0</mu2>
</gazebo>
</robot>
